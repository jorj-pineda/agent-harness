# Copy to .env and fill in. .env is gitignored.

# --- Providers ---
# Leave blank to disable a provider. The harness will pick up whichever are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional OpenAI-compatible chat endpoint (local or hosted). Set both URL and model.
# The key may be blank for local servers that do not require authentication.
# Do not put credentials or query tokens in the URL.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# Ollama runs locally; default host is fine for a normal install.
OLLAMA_HOST=http://localhost:11434

# Default provider when the API caller does not specify one.
DEFAULT_PROVIDER=ollama

# --- Model config ---
OLLAMA_MODEL=gemma4
OLLAMA_EMBED_MODEL=nomic-embed-text
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
# Memory optimization: q8_0 KV cache cuts 32k context from ~15GB to ~5GB.
# Set this in the Ollama server environment (not read by the harness itself).
# OLLAMA_KV_CACHE_TYPE=q8_0

# --- Data paths ---
SQLITE_DB_PATH=data/support.db
CHROMA_PATH=data/chroma
MEMORY_DB_PATH=data/memory.db

# --- Harness budgets ---
MAX_TOOL_ITERATIONS=8
MAX_TOOL_CALLS_PER_TURN=24
MAX_TURN_WALL_SECONDS=0
MAX_COMPLETION_TOKENS_PER_TURN=0
# Stop before another identical call after this many consecutive unchanged results (0 disables).
MAX_IDENTICAL_TOOL_CALLS=2
REQUEST_TIMEOUT_SECONDS=60
MAX_COMPLETION_RETRIES=1
# Optional exact post-edit check, encoded as JSON argv. Requires the executable
# to be in the code tool allowlist (pytest, ruff check, mypy, python -m pytest).
# PROJECT_CHECK_ARGV=["pytest","-q"]

# --- Grounding ---
CONFIDENCE_ESCALATION_THRESHOLD=0.55

# --- Coding agent ---
# When true, edited turns get one bounded retry if the required post-edit check is missing or failed.
REQUIRE_VERIFICATION_BEFORE_FINISH=false
# Legacy support SQL + RAG tools (requires python -m data.seed && data.embed).
ENABLE_SUPPORT_TOOLS=false
# Block file-tool edits to additional distinct files once this count is reached (0 disables).
MAX_FILES_TOUCHED_PER_TURN=5
# Block write_file/replace_text until emit_plan succeeds in the same turn.
REQUIRE_PLAN_BEFORE_EDIT=false
# Default repo sandbox for sessions that omit workspace_root (Docker sets /app/fixtures/tiny_repo).
# DEFAULT_WORKSPACE_ROOT=/app/fixtures/tiny_repo

# --- Logging ---
LOG_LEVEL=INFO
